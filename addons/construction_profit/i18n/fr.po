#. module: construction_profit
#: model:ir.model.fields,field_description:construction_profit.field_construction_site__cash_position
msgid "Cash Position"
msgstr "Position de trésorerie"

#. module: construction_profit
#: model:ir.model.fields,help:construction_profit.field_construction_site__cash_position
msgid "Cash received from the client minus the total cost so far."
msgstr "Encaissements du client moins le coût total à ce jour."

#. module: construction_profit
#: model:ir.model.fields,help:construction_profit.field_construction_site__collected_amount
msgid "Cash received from the client on progress and retention invoices."
msgstr "Encaissements du client sur les factures d'avancement et de retenue de garantie."

#. module: construction_profit
#: model:ir.model.fields,field_description:construction_profit.field_construction_site__collected_amount
msgid "Collected Amount"
msgstr "Montant encaissé"

#. module: construction_profit
#: model:ir.model,name:construction_profit.model_construction_site
msgid "Construction Site"
msgstr "Chantier"

#. module: construction_profit
#: model:ir.model.fields,help:construction_profit.field_construction_site__forecast_margin
msgid "Contract value minus the forecast cost at completion."
msgstr "Valeur du contrat moins le coût prévisionnel à l'achèvement."

#. module: construction_profit
#: model_terms:ir.ui.view,arch_db:construction_profit.view_construction_site_form_profit
msgid "Cost and Margin"
msgstr "Coût et marge"

#. module: construction_profit
#: model:ir.model.fields,field_description:construction_profit.field_construction_site__display_name
msgid "Display Name"
msgstr "Nom affiché"

#. module: construction_profit
#: model:ir.model.fields,help:construction_profit.field_construction_site__forecast_cost
msgid ""
"Estimated total cost at completion. Cost so far is extrapolated by the cost "
"of the work done (planned cost divided by earned value, times the cost so "
"far)."
msgstr "Coût total estimé à l'achèvement. Le coût à ce jour est extrapolé selon le coût des travaux réalisés (coût prévu divisé par la valeur acquise, multiplié par le coût à ce jour)."

#. module: construction_profit
#: model:ir.model.fields,field_description:construction_profit.field_construction_site__forecast_cost
msgid "Forecast Cost"
msgstr "Coût prévisionnel"

#. module: construction_profit
#: model:ir.model.fields,field_description:construction_profit.field_construction_site__forecast_margin
msgid "Forecast Margin"
msgstr "Marge prévisionnelle"

#. module: construction_profit
#: model:ir.model.fields,field_description:construction_profit.field_construction_site__forecast_margin_percent
msgid "Forecast margin (%)"
msgstr "Marge prévisionnelle (%)"

#. module: construction_profit
#: model:ir.model.fields,help:construction_profit.field_construction_site__forecast_margin_percent
msgid "Forecast margin as a share of the contract value."
msgstr "Marge prévisionnelle en pourcentage de la valeur du contrat."

#. module: construction_profit
#: model:ir.model.fields,field_description:construction_profit.field_construction_site__id
msgid "ID"
msgstr "ID"

#. module: construction_profit
#: model_terms:ir.ui.view,arch_db:construction_profit.view_construction_site_form_profit
msgid "Income"
msgstr "Produits"

#. module: construction_profit
#: model:ir.model.fields,help:construction_profit.field_construction_site__receivable_amount
msgid "Posted client invoices that are not paid yet."
msgstr "Factures clients comptabilisées et non encore payées."

#. module: construction_profit
#: model_terms:ir.ui.view,arch_db:construction_profit.view_construction_site_form_profit
msgid "Profit and Loss"
msgstr "Résultat"

