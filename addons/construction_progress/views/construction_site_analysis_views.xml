<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_construction_site_cost_graph" model="ir.ui.view">
        <field name="name">construction.site.cost.graph</field>
        <field name="model">construction.site</field>
        <field name="arch" type="xml">
            <graph string="Cost by site" type="bar">
                <field name="name"/>
                <field name="budget" type="measure"/>
                <field name="boq_total" type="measure"/>
                <field name="committed_cost" type="measure"/>
                <field name="actual_cost" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_construction_site_cost_pivot" model="ir.ui.view">
        <field name="name">construction.site.cost.pivot</field>
        <field name="model">construction.site</field>
        <field name="arch" type="xml">
            <pivot string="Cost analysis">
                <field name="state" type="row"/>
                <field name="budget" type="measure"/>
                <field name="boq_total" type="measure"/>
                <field name="committed_cost" type="measure"/>
                <field name="actual_cost" type="measure"/>
                <field name="earned_value" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_cost_overview_graph" model="ir.actions.act_window.view">
        <field name="sequence">20</field>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="view_construction_site_cost_graph"/>
        <field name="act_window_id" ref="construction_cost.action_construction_cost_overview"/>
    </record>
    <record id="action_cost_overview_pivot" model="ir.actions.act_window.view">
        <field name="sequence">30</field>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_construction_site_cost_pivot"/>
        <field name="act_window_id" ref="construction_cost.action_construction_cost_overview"/>
    </record>
    <record id="construction_cost.action_construction_cost_overview" model="ir.actions.act_window">
        <field name="view_mode">list,graph,pivot</field>
    </record>
</odoo>
