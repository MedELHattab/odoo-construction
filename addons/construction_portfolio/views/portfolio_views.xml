<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_construction_portfolio_list" model="ir.ui.view">
        <field name="name">construction.portfolio.list</field>
        <field name="model">construction.portfolio</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-danger="over_budget" decoration-muted="state in ('done', 'cancelled')">
                <field name="site_id"/>
                <field name="partner_id" optional="show"/>
                <field name="manager_id" widget="many2one_avatar_user" optional="show"/>
                <field name="state" widget="badge"/>
                <field name="progress_percent" widget="progressbar"/>
                <field name="budget" sum="Total"/>
                <field name="total_cost" sum="Total"/>
                <field name="billed_amount" sum="Total"/>
                <field name="margin_to_date" sum="Total" decoration-danger="margin_to_date &lt; 0"/>
                <field name="retention_held" sum="Total" optional="hide"/>
                <field name="open_punch" sum="Total"/>
                <field name="overdue_punch" sum="Total" decoration-danger="overdue_punch &gt; 0"/>
                <field name="failed_inspections" sum="Total" optional="show"/>
                <field name="over_budget" column_invisible="True"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_construction_portfolio_pivot" model="ir.ui.view">
        <field name="name">construction.portfolio.pivot</field>
        <field name="model">construction.portfolio</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="state" type="row"/>
                <field name="budget" type="measure"/>
                <field name="total_cost" type="measure"/>
                <field name="billed_amount" type="measure"/>
                <field name="margin_to_date" type="measure"/>
                <field name="site_count" type="measure"/>
                <field name="over_budget" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_construction_portfolio_graph" model="ir.ui.view">
        <field name="name">construction.portfolio.graph</field>
        <field name="model">construction.portfolio</field>
        <field name="arch" type="xml">
            <graph type="bar" stacked="0">
                <field name="site_id"/>
                <field name="budget" type="measure"/>
                <field name="total_cost" type="measure"/>
                <field name="billed_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_construction_portfolio_search" model="ir.ui.view">
        <field name="name">construction.portfolio.search</field>
        <field name="model">construction.portfolio</field>
        <field name="arch" type="xml">
            <search>
                <field name="site_id"/>
                <field name="partner_id"/>
                <field name="manager_id"/>
                <filter name="active_sites" string="In progress" domain="[('state', '=', 'in_progress')]"/>
                <filter name="over_budget" string="Over budget" domain="[('over_budget', '=', 1)]"/>
                <filter name="late" string="Past end date" domain="[('late_sites', '=', 1)]"/>
                <filter name="risks" string="Open risks"
                        domain="['|', '|', ('overdue_punch', '&gt;', 0), ('failed_inspections', '&gt;', 0), ('margin_to_date', '&lt;', 0)]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_manager" string="Site manager" context="{'group_by': 'manager_id'}"/>
                    <filter name="group_partner" string="Client" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_construction_portfolio" model="ir.actions.act_window">
        <field name="name">Portfolio</field>
        <field name="res_model">construction.portfolio</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="context">{'search_default_active_sites': 1}</field>
    </record>

    <menuitem id="menu_construction_portfolio" name="Portfolio"
              parent="construction_site.menu_construction_root"
              action="action_construction_portfolio" sequence="5"/>
</odoo>
