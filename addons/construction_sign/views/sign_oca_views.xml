<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sign_oca_template_generate_form_site" model="ir.ui.view">
        <field name="name">sign.oca.template.generate.form.site</field>
        <field name="model">sign.oca.template.generate</field>
        <field name="inherit_id" ref="sign_oca.sign_oca_template_generate_form_view"/>
        <field name="arch" type="xml">
            <field name="template_id" position="attributes">
                <attribute name="invisible">context.get('default_template_id')</attribute>
                <attribute name="required">1</attribute>
            </field>
            <field name="template_id" position="after">
                <field name="site_id"/>
            </field>
        </field>
    </record>

    <record id="sign_oca_request_form_site" model="ir.ui.view">
        <field name="name">sign.oca.request.form.site</field>
        <field name="model">sign.oca.request</field>
        <field name="inherit_id" ref="sign_oca.sign_oca_request_form_view"/>
        <field name="arch" type="xml">
            <field name="template_id" position="after">
                <field name="site_id"/>
            </field>
        </field>
    </record>

    <record id="sign_oca_request_list_site" model="ir.ui.view">
        <field name="name">sign.oca.request.list.site</field>
        <field name="model">sign.oca.request</field>
        <field name="inherit_id" ref="sign_oca.sign_oca_request_tree_view"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="site_id" optional="show"/>
            </field>
        </field>
    </record>

    <record id="sign_oca_request_search_site" model="ir.ui.view">
        <field name="name">sign.oca.request.search.site</field>
        <field name="model">sign.oca.request</field>
        <field name="inherit_id" ref="sign_oca.sign_oca_request_search_view"/>
        <field name="arch" type="xml">
            <field name="template_id" position="after">
                <field name="site_id"/>
            </field>
        </field>
    </record>
</odoo>
