<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_construction_site_form_sign" model="ir.ui.view">
        <field name="name">construction.site.form.sign</field>
        <field name="model">construction.site</field>
        <field name="inherit_id" ref="construction_site.view_construction_site_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_send_for_signature" string="Send for Signature" type="object"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_sign_requests" type="object" class="oe_stat_button"
                        icon="fa-pencil-square-o">
                    <field name="sign_request_count" widget="statinfo" string="Signatures"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
