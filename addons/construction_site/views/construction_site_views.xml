<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_construction_site_list" model="ir.ui.view">
        <field name="name">construction.site.list</field>
        <field name="model">construction.site</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="manager_id" widget="many2one_avatar_user"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="budget" sum="Total"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'done'"
                       decoration-warning="state == 'on_hold'"
                       decoration-primary="state == 'in_progress'"/>
            </list>
        </field>
    </record>

    <record id="view_construction_site_form" model="ir.ui.view">
        <field name="name">construction.site.form</field>
        <field name="model">construction.site</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" string="Start" type="object" class="btn-primary"
                            invisible="state not in ('draft', 'on_hold')"/>
                    <button name="action_hold" string="Put On Hold" type="object"
                            invisible="state != 'in_progress'"/>
                    <button name="action_done" string="Complete" type="object"
                            invisible="state != 'in_progress'"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('done', 'cancelled')"/>
                    <button name="action_draft" string="Reset to Planned" type="object"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_project" type="object" class="oe_stat_button"
                                icon="fa-tasks" invisible="not project_id">
                            <field name="task_count" widget="statinfo" string="Tasks"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Site name"/></h1>
                        <h3><field name="code"/></h3>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="manager_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="project_id" readonly="True"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="budget"/>
                            <field name="currency_id" invisible="True"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Address" name="address">
                            <field name="address"/>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_construction_site_search" model="ir.ui.view">
        <field name="name">construction.site.search</field>
        <field name="model">construction.site</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                <field name="partner_id"/>
                <field name="manager_id"/>
                <filter name="in_progress" string="In Progress" domain="[('state', '=', 'in_progress')]"/>
                <filter name="my_sites" string="My Sites" domain="[('manager_id', '=', uid)]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_client" string="Client" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_construction_site" model="ir.actions.act_window">
        <field name="name">Construction Sites</field>
        <field name="res_model">construction.site</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first construction site</p>
        </field>
    </record>

    <menuitem id="menu_construction_root" name="Construction" sequence="20"/>
    <menuitem id="menu_construction_sites" name="Sites" parent="menu_construction_root"
              action="action_construction_site" sequence="10"/>
</odoo>
