<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="privilege_construction" model="res.groups.privilege">
        <field name="name">Construction</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>

    <record id="group_construction_viewer" model="res.groups">
        <field name="name">Viewer</field>
        <field name="privilege_id" ref="privilege_construction"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_construction_manager" model="res.groups">
        <field name="name">Site Manager</field>
        <field name="privilege_id" ref="privilege_construction"/>
        <field name="implied_ids" eval="[(4, ref('group_construction_viewer'))]"/>
    </record>
    <record id="group_construction_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="privilege_construction"/>
        <field name="implied_ids" eval="[(4, ref('group_construction_manager'))]"/>
    </record>

    <!-- Keep existing users working: Project users/managers and system admins get the matching role. -->
    <record id="project.group_project_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_construction_viewer'))]"/>
    </record>
    <record id="project.group_project_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_construction_manager'))]"/>
    </record>
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_construction_admin'))]"/>
    </record>

    <record id="rule_construction_site_company" model="ir.rule">
        <field name="name">Construction site: multi-company</field>
        <field name="model_id" ref="model_construction_site"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
