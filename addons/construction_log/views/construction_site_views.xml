<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_construction_site_form_log" model="ir.ui.view">
        <field name="name">construction.site.form.log</field>
        <field name="model">construction.site</field>
        <field name="inherit_id" ref="construction_site.view_construction_site_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_logs" type="object" class="oe_stat_button" icon="fa-book">
                    <field name="log_count" widget="statinfo" string="Daily Logs"/>
                </button>
            </xpath>
            <field name="date_end" position="after">
                <field name="last_log_date"/>
                <field name="incident_count" invisible="not incident_count"
                       decoration-danger="incident_count &gt; 0"/>
            </field>
        </field>
    </record>
</odoo>
