<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_construction_progress_statement_list" model="ir.ui.view">
        <field name="name">construction.progress.statement.list</field>
        <field name="model">construction.progress.statement</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="site_id"/>
                <field name="partner_id"/>
                <field name="kind"/>
                <field name="date"/>
                <field name="gross_amount" sum="Gross"/>
                <field name="retention_amount" sum="Retention"/>
                <field name="net_amount" sum="Invoiced"/>
                <field name="state" widget="badge" decoration-success="state == 'invoiced'"
                       decoration-info="state == 'draft'"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_construction_progress_statement_form" model="ir.ui.view">
        <field name="name">construction.progress.statement.form</field>
        <field name="model">construction.progress.statement</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" string="Create Invoice" type="object" class="btn-primary"
                            invisible="state != 'draft'" groups="account.group_account_invoice"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,invoiced"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_invoice" type="object" class="oe_stat_button"
                                icon="fa-file-text-o" invisible="not invoice_id">
                            <div class="o_stat_info"><span class="o_stat_text">Invoice</span></div>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="site_id" readonly="state != 'draft'"/>
                            <field name="partner_id"/>
                            <field name="kind"/>
                        </group>
                        <group>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="retention_percent" readonly="state != 'draft'"
                                   invisible="kind == 'retention'"/>
                            <field name="company_id" invisible="True"/>
                            <field name="currency_id" invisible="True"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="state != 'draft'" invisible="kind == 'retention'">
                        <list editable="bottom" create="0" delete="0">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="contract_value"/>
                            <field name="previous_progress"/>
                            <field name="current_progress"/>
                            <field name="period_progress"/>
                            <field name="amount" sum="Gross"/>
                            <field name="currency_id" column_invisible="True"/>
                        </list>
                    </field>
                    <group class="oe_subtotal_footer">
                        <field name="release_amount" invisible="kind != 'retention'"/>
                        <field name="gross_amount"/>
                        <field name="retention_amount" invisible="kind == 'retention'"/>
                        <field name="net_amount" class="oe_subtotal_footer_separator"/>
                    </group>
                    <field name="note" placeholder="Internal note"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_construction_progress_statement_search" model="ir.ui.view">
        <field name="name">construction.progress.statement.search</field>
        <field name="model">construction.progress.statement</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="site_id"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="invoiced" string="Invoiced" domain="[('state', '=', 'invoiced')]"/>
                <group>
                    <filter name="group_site" string="Site" context="{'group_by': 'site_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_construction_progress_statement" model="ir.actions.act_window">
        <field name="name">Progress Billing</field>
        <field name="res_model">construction.progress.statement</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Bill your first progress statement</p>
            <p>Open a site and click New Progress Statement to invoice the work done so far.</p>
        </field>
    </record>

    <menuitem id="menu_construction_progress_statement" name="Progress Billing"
              parent="construction_site.menu_construction_root"
              action="action_construction_progress_statement" sequence="25"/>
</odoo>
