<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_site" model="ir.ui.view">
        <field name="name">purchase.order.form.site</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="site_id"/>
            </field>
        </field>
    </record>

    <record id="purchase_order_search_site" model="ir.ui.view">
        <field name="name">purchase.order.search.site</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.view_purchase_order_filter"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="site_id"/>
            </field>
        </field>
    </record>

    <record id="res_partner_form_subcontractor" model="ir.ui.view">
        <field name="name">res.partner.form.subcontractor</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <field name="category_id" position="after">
                <field name="is_subcontractor"/>
            </field>
        </field>
    </record>

    <record id="res_partner_search_subcontractor" model="ir.ui.view">
        <field name="name">res.partner.search.subcontractor</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <filter name="inactive" position="before">
                <filter name="subcontractors" string="Subcontractors"
                        domain="[('is_subcontractor', '=', True)]"/>
            </filter>
        </field>
    </record>
</odoo>
