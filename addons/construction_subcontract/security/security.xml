<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_construction_subcontract_company" model="ir.rule">
        <field name="name">Subcontract: multi-company</field>
        <field name="model_id" ref="model_construction_subcontract"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_construction_subcontract_payment_company" model="ir.rule">
        <field name="name">Subcontract payment: multi-company</field>
        <field name="model_id" ref="model_construction_subcontract_payment"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
