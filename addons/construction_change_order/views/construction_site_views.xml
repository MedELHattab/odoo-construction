<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_construction_site_form_change_order" model="ir.ui.view">
        <field name="name">construction.site.form.change.order</field>
        <field name="model">construction.site</field>
        <field name="inherit_id" ref="construction_site.view_construction_site_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_change_orders" type="object" class="oe_stat_button" icon="fa-exchange">
                    <field name="change_order_count" widget="statinfo" string="Change Orders"/>
                </button>
            </xpath>
            <field name="budget" position="after">
                <field name="approved_change_total" invisible="not approved_change_total"/>
            </field>
            <xpath expr="//field[@name='boq_line_ids']/list/field[@name='name']" position="after">
                <field name="change_order_id" optional="show" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
