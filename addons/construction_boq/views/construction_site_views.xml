<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_construction_site_form_boq" model="ir.ui.view">
        <field name="name">construction.site.form.boq</field>
        <field name="model">construction.site</field>
        <field name="inherit_id" ref="construction_site.view_construction_site_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_create_quotation" string="Create Quotation" type="object"
                        invisible="sale_order_id or not boq_line_ids"
                        groups="sales_team.group_sale_salesman"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_quotation" type="object" class="oe_stat_button"
                        icon="fa-file-text-o" invisible="not sale_order_id"
                        groups="sales_team.group_sale_salesman">
                    <div class="o_stat_info"><span class="o_stat_text">Quotation</span></div>
                </button>
            </xpath>
            <field name="budget" position="after">
                <field name="boq_total"/>
                <field name="budget_variance"
                       decoration-danger="budget_variance &lt; 0"
                       decoration-success="budget_variance &gt;= 0"/>
                <field name="markup"/>
                <field name="sale_order_id" invisible="True"/>
            </field>
            <xpath expr="//page[@name='address']" position="before">
                <page string="Bill of Quantities" name="boq">
                    <field name="boq_line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="product_id"/>
                            <field name="name"/>
                            <field name="quantity"/>
                            <field name="uom_id"/>
                            <field name="unit_cost"/>
                            <field name="subtotal" sum="Total"/>
                            <field name="currency_id" column_invisible="True"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
