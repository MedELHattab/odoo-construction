<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_construction_equipment_company" model="ir.rule">
        <field name="name">Construction equipment: multi-company</field>
        <field name="model_id" ref="model_construction_equipment"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_construction_equipment_usage_company" model="ir.rule">
        <field name="name">Construction equipment assignment: multi-company</field>
        <field name="model_id" ref="model_construction_equipment_usage"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
