<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_construction_alerts" model="ir.cron">
        <field name="name">Construction: daily site alerts</field>
        <field name="model_id" ref="construction_site.model_construction_site"/>
        <field name="state">code</field>
        <field name="code">model._run_alerts()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <record id="param_budget_warning_percent" model="ir.config_parameter">
        <field name="key">construction_alert.budget_warning_percent</field>
        <field name="value">90</field>
    </record>
</odoo>
