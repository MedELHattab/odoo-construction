<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_construction_site_form_expense" model="ir.ui.view">
        <field name="name">construction.site.form.expense</field>
        <field name="model">construction.site</field>
        <field name="inherit_id" ref="construction_site.view_construction_site_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_expenses" type="object" class="oe_stat_button"
                        icon="fa-credit-card" groups="hr_expense.group_hr_expense_user">
                    <field name="expense_count" widget="statinfo" string="Expenses"/>
                </button>
            </xpath>
            <field name="equipment_cost" position="after">
                <field name="expense_cost"/>
            </field>
        </field>
    </record>

    <record id="view_construction_site_cost_list_expense" model="ir.ui.view">
        <field name="name">construction.site.cost.list.expense</field>
        <field name="model">construction.site</field>
        <field name="inherit_id" ref="construction_cost.view_construction_site_cost_list"/>
        <field name="arch" type="xml">
            <field name="equipment_cost" position="after">
                <field name="expense_cost" sum="Expenses"/>
            </field>
        </field>
    </record>

    <record id="view_construction_site_cost_pivot_expense" model="ir.ui.view">
        <field name="name">construction.site.cost.pivot.expense</field>
        <field name="model">construction.site</field>
        <field name="inherit_id" ref="construction_progress.view_construction_site_cost_pivot"/>
        <field name="arch" type="xml">
            <field name="equipment_cost" position="after">
                <field name="expense_cost" type="measure"/>
            </field>
        </field>
    </record>

    <record id="view_construction_site_cost_graph_expense" model="ir.ui.view">
        <field name="name">construction.site.cost.graph.expense</field>
        <field name="model">construction.site</field>
        <field name="inherit_id" ref="construction_progress.view_construction_site_cost_graph"/>
        <field name="arch" type="xml">
            <field name="equipment_cost" position="after">
                <field name="expense_cost" type="measure"/>
            </field>
        </field>
    </record>
</odoo>
