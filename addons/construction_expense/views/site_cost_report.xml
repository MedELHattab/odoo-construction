<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_site_cost_expense" inherit_id="construction_report.report_site_cost">
        <xpath expr="//h5[@id='section_progress']" position="before">
            <t t-set="can_see_expenses" t-value="env.user.has_group('hr_expense.group_hr_expense_user')"/>
            <h5 class="mt-4">Expenses</h5>
            <t t-set="expense_total" t-value="site.expense_cost"/>
            <table class="table table-sm">
                <tbody>
                    <tr>
                        <td>Approved employee expenses</td>
                        <td class="text-end"><span t-field="site.expense_cost"/></td>
                    </tr>
                </tbody>
            </table>
            <t t-if="can_see_expenses">
                <t t-set="counted_expenses" t-value="site.expense_ids.filtered(lambda e: e.state in ('approved', 'posted', 'in_payment', 'paid'))"/>
                <table class="table table-sm" t-if="counted_expenses">
                    <thead>
                        <tr><th>Date</th><th>Expense</th><th>Employee</th><th class="text-end">Amount</th></tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="counted_expenses" t-as="expense">
                            <td><span t-field="expense.date"/></td>
                            <td><span t-field="expense.name"/></td>
                            <td><span t-field="expense.employee_id"/></td>
                            <td class="text-end"><span t-field="expense.total_amount"/></td>
                        </tr>
                    </tbody>
                </table>
            </t>
        </xpath>
    </template>
</odoo>
