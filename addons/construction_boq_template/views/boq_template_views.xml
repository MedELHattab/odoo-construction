<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_construction_boq_category_list" model="ir.ui.view">
        <field name="name">construction.boq.category.list</field>
        <field name="model">construction.boq.category</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_construction_boq_template_list" model="ir.ui.view">
        <field name="name">construction.boq.template.list</field>
        <field name="model">construction.boq.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="total"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_construction_boq_template_form" model="ir.ui.view">
        <field name="name">construction.boq.template.form</field>
        <field name="model">construction.boq.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="Template name"/></h1></div>
                    <group>
                        <field name="description"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="currency_id" invisible="True"/>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="category_id"/>
                            <field name="product_id"/>
                            <field name="name"/>
                            <field name="quantity"/>
                            <field name="uom_id"/>
                            <field name="unit_cost"/>
                            <field name="subtotal" sum="Total"/>
                            <field name="currency_id" column_invisible="True"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_construction_boq_template" model="ir.actions.act_window">
        <field name="name">BoQ Templates</field>
        <field name="res_model">construction.boq.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a reusable bill of quantities template</p>
        </field>
    </record>

    <record id="action_construction_boq_category" model="ir.actions.act_window">
        <field name="name">Cost Categories</field>
        <field name="res_model">construction.boq.category</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_construction_config" name="Configuration"
              parent="construction_site.menu_construction_root" sequence="90"
              groups="construction_site.group_construction_manager"/>
    <menuitem id="menu_construction_boq_template" name="BoQ Templates"
              parent="menu_construction_config" action="action_construction_boq_template" sequence="10"/>
    <menuitem id="menu_construction_boq_category" name="Cost Categories"
              parent="menu_construction_config" action="action_construction_boq_category" sequence="20"/>
</odoo>
